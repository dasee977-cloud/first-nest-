<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label="{{ site.name }} home">
      <span class="logo__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="20" r="19" fill="#FFE14A" stroke="#0B1340" stroke-width="2"/><path d="M8 22c3 8 21 8 24 0" fill="none" stroke="#0B1340" stroke-width="3" stroke-linecap="round"/><path d="M10 20c4 4 16 4 20 0" fill="none" stroke="#FF6FB1" stroke-width="3" stroke-linecap="round"/><ellipse cx="16" cy="16" rx="3.2" ry="4" fill="#fff" stroke="#0B1340" stroke-width="2"/><ellipse cx="23.5" cy="15" rx="3.2" ry="4" fill="#fff" stroke="#0B1340" stroke-width="2"/></svg>
      </span>
      <span class="logo__text">First<br>Nest</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in nav %}
        {%- set isActive = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if isActive %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
